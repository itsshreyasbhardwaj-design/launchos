# LaunchOS runs with this file absent. Every variable here is OPTIONAL.
# Nothing in LaunchOS requires a paid service or an AI API key.

# --- Storage ---
# Path to the local SQLite database. Default: ./data/launchos.db
LAUNCHOS_DB=./data/launchos.db

# --- Crawler safety / politeness ---
LAUNCHOS_CRAWL_MAX_PAGES=40          # hard cap on pages per audit
LAUNCHOS_CRAWL_DELAY_MS=750          # delay between requests to one host
LAUNCHOS_CRAWL_TIMEOUT_MS=15000
LAUNCHOS_USER_AGENT=LaunchOS-Audit/0.1 (+https://github.com/)
# Set to 1 ONLY on a trusted private network you own. Disables private-IP blocking.
# LAUNCHOS_ALLOW_PRIVATE_HOSTS=0

# --- Optional free integrations (all absent by default) ---
# IndexNow: requires you to host the key file at https://yoursite/<key>.txt
# INDEXNOW_KEY=
# Google Search Console API (free, OAuth). Absent => use CSV export import instead.
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
