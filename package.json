{
  "name": "launchos",
  "version": "0.1.0",
  "private": false,
  "description": "Free, open-source post-launch growth, SEO, GEO and distribution operating system.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "launchos": "./bin/launchos.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 3211",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "build:core": "tsc -p tsconfig.core.json && node -e \"require('fs').writeFileSync('dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "cli": "npm run build:core --silent && node bin/launchos.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsshreyasbhardwaj-design/launchos.git"
  },
  "bugs": {
    "url": "https://github.com/itsshreyasbhardwaj-design/launchos/issues"
  },
  "homepage": "https://github.com/itsshreyasbhardwaj-design/launchos#readme",
  "keywords": [
    "seo",
    "geo",
    "aeo",
    "growth",
    "marketing",
    "site-audit",
    "structured-data",
    "indexnow",
    "local-first",
    "cli"
  ]
}
